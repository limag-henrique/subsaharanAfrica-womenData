---
config:
  theme: default
  look: classic
  layout: dagre
---
erDiagram
    Pais {
        TEXT codigo PK
        TEXT nome UK
    }
    Levantamento {
        TEXT id PK
        TEXT pais_codigo FK
        TEXT fase
    }
    Domicilio {
        TEXT id PK
        TEXT levantamento_id FK
        INTEGER cluster
        INTEGER numero
        INTEGER regiao
        INTEGER residencia
        INTEGER riqueza
        INTEGER eletricidade
        INTEGER fonte_agua
        INTEGER membros
        TEXT origem
    }
    Mulher {
        TEXT id PK
        TEXT domicilio_id FK
        INTEGER linha
        INTEGER idade
        INTEGER escolaridade
        INTEGER filhos_nascidos_vivos
        INTEGER idade_primeiro_nascimento
    }
    Parceiro {
        TEXT id PK
        TEXT domicilio_id FK
        INTEGER linha
        INTEGER idade
        INTEGER escolaridade
        INTEGER total_filhos
        INTEGER idade_primeiro_filho
    }
    Entrevista {
        TEXT mulher_id PK,FK
        INTEGER data_cmc
        REAL peso
        INTEGER usa_metodo
        TEXT coorte
    }
    Nascimento {
        TEXT id PK
        TEXT mulher_id FK
        INTEGER data_cmc
        INTEGER consultas_prenatal_codigo
        INTEGER local_parto_codigo
        INTEGER cesarea_codigo
        INTEGER assistencia_medico_codigo
        INTEGER assistencia_m3b_codigo
        TEXT campos_conflitantes
    }
    Crianca {
        TEXT id PK
        TEXT nascimento_id FK
        INTEGER indice
        INTEGER sexo
        INTEGER vivo
        INTEGER idade_anos
        INTEGER ordem_multiplo
        INTEGER tem_registro_kr
        TEXT origem
    }
    Vacina_Remedio {
        INTEGER id PK
        TEXT codigo UK
        TEXT nome UK
    }
    Crianca_Vacina {
        TEXT crianca_id PK,FK
        INTEGER vacina_id PK,FK
        INTEGER status_codigo
    }
    Morador {
        TEXT id PK
        TEXT domicilio_id FK
        INTEGER linha
        INTEGER sexo
        INTEGER idade
        INTEGER escolaridade_codigo
        INTEGER relacao_chefe_codigo
    }
    Metodo {
        INTEGER id PK
        TEXT nome UK
        TEXT classe
    }
    Conhecimento_Metodo {
        TEXT mulher_id PK,FK
        INTEGER metodo_id PK,FK
        INTEGER nivel
    }
    Pais ||..o{ Levantamento : realiza
    Levantamento ||..o{ Domicilio : amostra
    Domicilio ||..o{ Morador : abriga
    Domicilio ||..o{ Mulher : reside
    Domicilio ||..o{ Parceiro : reside
    Mulher ||--o| Entrevista : responde
    Mulher ||..o{ Nascimento : tem_parto
    Nascimento ||..o{ Crianca : origina
    Mulher ||--o{ Conhecimento_Metodo : informa
    Metodo ||--o{ Conhecimento_Metodo : classifica
    Crianca ||--o{ Crianca_Vacina : recebe
    Vacina_Remedio ||--o{ Crianca_Vacina : identifica
